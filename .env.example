# InfluxDB Configuration
INFLUXDB_URL=http://your-influxdb-ip:8086
INFLUXDB_TOKEN=your-super-secret-token
INFLUXDB_ORG=your-org
INFLUXDB_BUCKET=internet_monitor

# App Configuration
PORT=8181
ADMIN_PASSWORD=change-this-password

# Intervals
PING_INTERVAL=60
SPEEDTEST_INTERVAL=144
PING_TARGET=8.8.8.8
